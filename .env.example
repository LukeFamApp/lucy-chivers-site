NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses RLS — required for the /admin dashboard to read the
# subscribers table (which only allows public INSERT via RLS).
# Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the /admin dashboard, checked server-side only.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie (JWT). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
